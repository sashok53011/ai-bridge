# Секреты AI-приставки. Лежит в /etc/ai-bridge.env, chmod 600.
# Копия: cp deploy/debian/ai-bridge.env.example /etc/ai-bridge.env
#
# Логин каталога на app.devhorizon.online (тот же, что у Flutter-приложения).
# Без него служба не стартует — каталог и статистика требуют входа.
AI_BRIDGE_EMAIL=you@example.com
AI_BRIDGE_PASSWORD=смените_на_настоящий_пароль

# Необязательно: свой токен приставки (иначе создаётся сам в
# /var/lib/ai-bridge/token при первом запуске).
# AI_BRIDGE_TOKEN=

# Необязательно: адрес сервера каталога, если он рядом (например
# http://127.0.0.1:8090); по умолчанию https://app.devhorizon.online.
# AI_BRIDGE_SERVER=

# Необязательно: путь к локальной базе PocketBase для раздела
# SQL Playground (только администратор, только чтение).
# Для включения укажите путь к data.db и отдельно настройте проход по
# родительским каталогам и чтение базы/WAL для пользователя ai-bridge.
# AI_BRIDGE_SQLITE_PATH=/home/sashok5301/pocketbase-ai/pb_data/data.db
